# Template for the DEPLOYED frontend build - not a local-dev file.
#
# CI (.github/workflows/deploy.yml -> hotosm/gh-workflows just.yml) runs this
# file through envsubst, substituting Github environment variables, and writes
# the result to .env; `just build-frontend` sources that for its Vite build
# args. So any value NOT set as a Github variable is baked into the production
# bundle, and the defaults below must be production URLs.
#
# Running locally needs no .env at all: compose.yaml carries its own local
# defaults inline (`${VAR:-http://...localhost:8080}`) and `just start all` just
# calls docker compose. Copying this file to .env verbatim will therefore point
# your LOCAL frontend at production - if you want a .env, put only the variables
# you are actually overriding in it, or uncomment the localhost lines below.
#
# Uploader-specific settings are in backend/uploader-api/.env.example.

# Frontend

# These archives are not built locally, so they use the production bucket.
VITE_PMTILES_URL=${VITE_PMTILES_URL:-https://s3.amazonaws.com/oin-hotosm-temp/global-data.pmtiles}
VITE_DENSITY_PMTILES_URL=${VITE_DENSITY_PMTILES_URL:-https://s3.amazonaws.com/oin-hotosm-temp/global-coverage.pmtiles}
# For a local .env, swap to the commented localhost lines (`just test
# populate-prod` adds sample data to the local catalog).
VITE_STAC_TITILER_URL=${VITE_STAC_TITILER_URL:-https://api.imagery.hotosm.org/raster}
# VITE_STAC_TITILER_URL=${VITE_STAC_TITILER_URL:-http://imagery.localhost:8080/raster}
VITE_STAC_URL=${VITE_STAC_URL:-https://api.imagery.hotosm.org/stac}
# VITE_STAC_URL=${VITE_STAC_URL:-http://imagery.localhost:8080/stac}
VITE_STAC_BROWSER_URL=${VITE_STAC_BROWSER_URL:-https://api.imagery.hotosm.org/browser}
# The uploader DOES run locally (compose `uploader-api`, proxied by local.conf as
# upload.imagery.localhost). For a local .env, swap to the commented line.
VITE_UPLOADER_URL=${VITE_UPLOADER_URL:-https://upload.imagery.hotosm.org}
# VITE_UPLOADER_URL=${VITE_UPLOADER_URL:-http://upload.imagery.localhost:8080}
VITE_PACKAGER_URL=${VITE_PACKAGER_URL:-https://packager.imagery.hotosm.org}
VITE_ANNOUNCEMENT_URL=${VITE_ANNOUNCEMENT_URL:-https://d33erh71igmru9.cloudfront.net/oam.json}

VITE_STAC_MAP_DEFAULT_HREF=${VITE_STAC_MAP_DEFAULT_HREF:-https://api.imagery.hotosm.org/stac}

# Number of items loaded by `just test populate-prod`.
POPULATE_ITEMS=${POPULATE_ITEMS:-20}

# Copy this file to .env for local overrides.

# App
APP_NAME="OAM Uploader"
# In production, use upload.imagery.hotosm.org and leave the dev port empty.
OAM_UPLOAD_DOMAIN=localhost
OAM_UPLOAD_DEV_PORT=8090
OAM_FRONTEND_URL=http://imagery.localhost:8080
OAM_API_URL=http://imagery.localhost:8080
DEBUG=true
LOG_LEVEL=INFO
# development | production. Production refuses to start on the dev defaults
# below (disabled auth, DEBUG, the placeholder cookie secret).
ENVIRONMENT=development

# disabled | hotosm | bundled | custom
AUTH_PROVIDER=disabled
# HANKO_API_URL=https://login.hotosm.org
# HANKO_PUBLIC_URL=https://login.hotosm.org
# LOGIN_URL=https://login.hotosm.org/app
# COOKIE_SECRET=change-me-to-a-32-character-secret

# Dedicated uploader database
DB_HOST=uploader-db
DB_PORT=5432
DB_USER=oam
DB_PASSWORD=oam
DB_NAME=oam_uploader
# DB_URL=postgresql://oam:oam@uploader-db:5432/oam_uploader

# Object storage
S3_ENDPOINT=http://rustfs:9000
S3_EXTERNAL_ENDPOINT=http://localhost:9000
S3_BUCKET=oam
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=oam
AWS_SECRET_ACCESS_KEY=oam

# Namespace-scoped Argo Workflows
ARGO_NAMESPACE=oam
ARGO_WORKFLOW_TEMPLATE=geotiff-processing-template
WF_CALLBACK_URL=http://uploader-api.oam.svc.cluster.local:8080

# Downstream STAC catalog
STAC_URL=http://stac-api:8082
STAC_COLLECTION=openaerialmap

# Remote-source ingest fetches a caller's source_url from inside the cluster.
# Allow private addresses only to reach an in-network object store in dev.
# FETCH_ALLOW_PRIVATE_HOSTS=false

# Optional OpenTelemetry
# Leave unset to disable. Heartbeat pings (__heartbeat__ / __lbheartbeat__)
# are never traced or logged regardless.
# MONITORING=openobserve            # sentry | openobserve
# SENTRY_DSN=https://xxx@sentry.io/1   # when MONITORING=sentry
# OTEL_ENDPOINT=http://openobserve:5081   # when MONITORING=openobserve
# OTEL_AUTH_TOKEN=base64-user:token       # optional OTLP basic-auth token
